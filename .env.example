# Copy this file to `.env` and fill in your key. `.env` is gitignored — never
# commit a real key. The loop auto-loads `.env` (see fuzz/loop/llm.py).
#
# Leave the key blank to run in MOCK mode (offline, no spend).

# --- required for a real run ---
DEEPSEEK_API_KEY=

# --- optional overrides (defaults shown) ---
# LLM_MODEL=deepseek-chat          # or deepseek-reasoner
# LLM_BASE_URL=https://api.deepseek.com
# LLM_PRICE_IN=0.27                # $ per 1M input tokens  (for runs/cost.md)
# LLM_PRICE_OUT=1.10               # $ per 1M output tokens
# LLM_MOCK=1                       # force MOCK mode even if a key is set
